# URL pública de la API (compilada por Vite en tiempo de build)
# Para desarrollo local: http://localhost:8000/api/v1
# Para producción/staging detrás del mismo dominio (OpenResty/Nginx): /api/v1
VITE_API_URL=http://localhost:8000/api/v1

# URL interna usada por el servidor Node SSR dentro de Docker
INTERNAL_API_URL=http://backend:8000/api/v1

